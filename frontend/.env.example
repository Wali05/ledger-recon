# Local development uses the Vite proxy and the real API at localhost:8000.
# Production builds without an API URL use the interactive sample demo.
# To connect a hosted API, set these at build time and redeploy:
# VITE_API_BASE_URL=https://your-api.example.com
# VITE_DEMO_MODE=false
# Never put an API key or database password in a VITE_ variable.
