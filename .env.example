# Copy to .env only if you want to override the defaults.
#
# NONE of these are required. With an empty environment the app falls back to
# SQLite + in-process task execution, which is enough to run everything.

# ── Database ────────────────────────────────────────────────────────────────
# ONE url. The app derives the async (asyncpg) and sync (psycopg2) drivers from
# it, and rewrites the legacy "postgres://" scheme that most managed providers
# still emit. Unset => a local SQLite file at backend/ledger_recon.db.
# DATABASE_URL=postgresql://recon_user:recon_pass@localhost:5432/ledger_recon

# ── Background processing ───────────────────────────────────────────────────
# Unset => Celery runs tasks inline in the API process (eager mode).
# Set these to run a real worker against a real broker.
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── Redis (AI rate limiting) ────────────────────────────────────────────────
# Unset => per-process in-memory counters instead of shared ones.
# REDIS_URL=redis://localhost:6379/0

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated browser origins allowed to call the API directly.
# Defaults to the local Vite dev server.
# ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.example.com

# ── Optional: AI break explanations (Google Gemini) ─────────────────────────
# Without this the app works fully; only the "Ask AI to Explain" button is off.
# GEMINI_API_KEY=your-key-here

# ── Only used by docker-compose ─────────────────────────────────────────────
# POSTGRES_PASSWORD=recon_pass
