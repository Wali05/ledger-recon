# Optional overrides. Uvicorn can load this with --env-file .env.
# Default: SQLite and one API process with background threads.
# DATABASE_URL=postgresql://recon_user:recon_pass@localhost:5432/ledger_recon
# CELERY_BROKER_URL=redis://localhost:6379/0
# REDIS_URL=redis://localhost:6379/0
# ALLOWED_ORIGINS=http://localhost:5173,https://your-dashboard.vercel.app
# AUTO_MIGRATE=true

# Require sign-in: comma-separated reviewer:key pairs (keys >= 16 characters).
# Each reviewer's name is recorded in the review history.
# API_KEYS=alice:change-me-to-a-long-random-key,bob:another-long-random-key

# Optional AI: install backend/requirements-ai.txt before setting a key.
# Keys belong only on the API server.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite

# Docker Compose only: change for a shared machine.
# POSTGRES_PASSWORD=recon_pass
